// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int    @id @default(autoincrement())
  first_name String
  last_name  String
  password   String
  age        Int
  role       Role   @default(BASIC)
  username   String @unique
  email      String @unique
  message Message[]

  ticket Ticket[] @relation("UserTickets")
  createdBy Ticket[] @relation("CreatedTickets")
  @@index([username, email])
}

model Ticket {
  id Int @id @default(autoincrement())
  title String 
  description String
  status Status
  priority Priority
  due_date DateTime
  
  assignee_user_id Int?
  created_by_user_id Int
  department_id Int
  source_channel_id Int
  
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  assignee User? @relation("UserTickets",fields: [assignee_user_id],references: [id])
  created_by User @relation("CreatedTickets",fields: [created_by_user_id],references: [id])
  department Department @relation(fields: [department_id],references: [id])
  source_channel Channel @relation(fields: [source_channel_id],references: [id])
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  channel     Channel[]
  message Message[]
  ticket Ticket[]
}

model Channel {
  id            Int        @id @default(autoincrement())
  name          String     @unique
  department    Department @relation(fields: [department_id], references: [id])
  department_id Int
  conversation Conversation[]
  ticket Ticket[]
}

model Conversation{
  id Int @id @default(autoincrement())
  name String @unique
  channel_id Int
  channel Channel @relation(fields: [channel_id],references: [id])
  message Message[]
}

model Message{
  id Int @id @default(autoincrement())
  user_id Int
  message String
  conversation_id Int
  department_id Int?
  department Department? @relation(fields: [department_id],references: [id])
  conversation Conversation @relation(fields: [conversation_id],references: [id])
  user User @relation(fields: [user_id],references: [id])
}

