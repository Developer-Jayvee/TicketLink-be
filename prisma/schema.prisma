// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String       @id @default(uuid())
  first_name String
  last_name  String
  password   String
  age        Int
  role       Role      @default(BASIC)
  username   String    @unique
  email      String    @unique
  message    Message[]

  channel Channel[]
  ticket    Ticket[] @relation("UserTickets")
  createdBy Ticket[] @relation("CreatedTickets")

  @@index([username, email])
}

model Ticket {
  id          String      @id @default(uuid())
  title       String
  description String
  status      Status
  priority    Priority
  due_date    DateTime

  assignee_user_id   String?
  created_by_user_id String
  department_id      String
  source_channel_id  String

  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  assignee       User?      @relation("UserTickets", fields: [assignee_user_id], references: [id])
  created_by     User       @relation("CreatedTickets", fields: [created_by_user_id], references: [id])
  department     Department @relation(fields: [department_id], references: [id])
  source_channel Channel    @relation(fields: [source_channel_id], references: [id])
}

model Department {
  id          String       @id @default(uuid())
  name        String
  description String
  channel     Channel[]
  message     Message[]
  ticket      Ticket[]
}

model GroupChat {
  id          String       @id @default(uuid())
  name        String
  description String
  channel     Channel[]
}

model Channel {
  id            String        @id @default(uuid())
  name          String     @unique
  department    Department @relation(fields: [department_id], references: [id])
  department_id String
  group_chat_id String
  created_by_id String


  createdBy User @relation(fields: [created_by_id],references: [id])
  groupChat    GroupChat      @relation(fields: [group_chat_id], references: [id])
  conversation Conversation[]
  ticket       Ticket[]
  // message      Message[]
}

model Conversation {
  id         String       @id @default(uuid())
  name       String    @unique
  channel_id String
  channel    Channel?   @relation(fields: [channel_id], references: [id])
  message    Message[]
}

model Message {
  id              String    @id @default(uuid())
  user_id         String 
  message         String
  channel_id      String
  
  conversation_id String?
  department_id   String?

  // channel      Channel       @relation(fields: [channel_id], references: [id])
  department   Department?   @relation(fields: [department_id], references: [id])
  conversation Conversation? @relation(fields: [conversation_id], references: [id])
  user         User          @relation(fields: [user_id], references: [id])
}

